{
  "name": "ai-note",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently \"pnpm run dev\" \"node scripts/electron-dev.js\"",
    "electron:build": "pnpm run build && electron-builder",
    "electron:dist": "pnpm run build && electron-builder --publish=never",
    "electron:pack": "pnpm run build && electron-builder --dir",
    "build:backend": "cd ../backend && python build.py",
    "build:full": "pnpm run build:backend && pnpm run build && electron-builder",
    "electron:clean": "rimraf dist dist-electron",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "element-plus": "^2.9.1",
    "marked": "^16.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "build": {
    "appId": "com.gaays.ai-note",
    "productName": "AI Note Generator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/video-note-backend",
        "to": "backend/video-note-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Output",
        "to": "Output",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Subtitles",
        "to": "Subtitles",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Prompts",
        "to": "Prompts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "rimraf": "^6.0.1",
    "sass": "^1.91.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.1"
  }
}
